# =============================================================================
# 무한매수법 V4.0 자동매매 프로그램 환경설정 예시 파일
# =============================================================================
# 이 파일을 복사해서 ".env"라는 이름으로 저장한 뒤 실제 값을 채워 넣으세요.
# ".env" 파일은 절대 git에 커밋하면 안 됩니다(App Secret 등 민감정보 포함).
#
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)

# --- 키움 REST API 인증 모드 ---
# real = 실투자, demo = 모의투자. 반드시 모의투자로 충분히 검증한 뒤 real로 전환하세요.
KIWOOM_MODE=demo

# --- 실투자(real) App Key/Secret ---
# KIWOOM_MODE=real일 때 필수. 키움 OpenAPI 포털에서 "실투자"용으로 발급받은 값을 넣으세요.
APP_KEY=
APP_SECRET=

# --- 모의투자(demo) App Key/Secret ---
# KIWOOM_MODE=demo일 때 필수. 키움 OpenAPI 포털에서 "모의투자"용으로 발급받은 값을 넣으세요.
APP_KEY_MOCK=
APP_SECRET_MOCK=

# --- 매매 대상 종목 ---
TICKER=TQQQ
# 거래소구분: NA=AMEX, ND=NASDAQ, NY=NYSE. TQQQ는 NASDAQ 상장이므로 기본값 ND.
EXCHANGE_CODE=ND

# --- 무한매수법 전략 파라미터 ---
# 분할수: 20 또는 40만 허용됩니다.
SPLIT_COUNT=40

# 총 원금(USD). 실제 투입하실 금액으로 반드시 직접 채워 넣으세요. (예: 10000)
PRINCIPAL=

# 사이클 재시작 시 원금 계산 방식.
#   true  = 복리 (직전 사이클 종료 시점 잔금을 다음 원금으로 그대로 이어받음)
#   false = 단리 (항상 PRINCIPAL 값으로 고정 재시작)
COMPOUND_ON_RESTART=true

# --- 저장 경로 (보통 기본값 그대로 사용, Docker 볼륨 마운트 경로와 일치해야 함) ---
# DB_PATH=./data/infinite_buying.db
# EVENT_LOG_PATH=./data/event_log.jsonl

# --- 로컬 대시보드 포트 ---
DASHBOARD_PORT=8000
