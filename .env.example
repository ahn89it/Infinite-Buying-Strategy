# =============================================================================
# 무한매수법 V4.0 자동매매 프로그램 환경설정 예시 파일
# =============================================================================
# 이 파일을 복사해서 ".env"라는 이름으로 저장한 뒤 실제 값을 채워 넣으세요.
# ".env" 파일은 절대 git에 커밋하면 안 됩니다(App Secret 등 민감정보 포함).
#
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)

# --- 키움 REST API 인증 (App Key/Secret) ---
# 주의: 키움증권 모의투자는 해외주식(미국주식)을 지원하지 않습니다. 이 프로그램은
# TQQQ(미국주식)만 다루므로 모의투자 계좌로는 애초에 검증할 수 없고, 이 프로젝트에는
# 모의/실투자 전환 옵션이 없습니다 — 항상 실투자 API로만 연결됩니다.
# 키움 OpenAPI 포털에서 "실투자"용으로 발급받은 App Key/Secret을 넣으세요.
APP_KEY=
APP_SECRET=

# --- 드라이런(실주문 없이 로직만 검증) ---
# 모의투자가 없는 대신 이 프로젝트가 제공하는 유일한 사전 검증 수단입니다.
# true면 시세/체결 조회는 실계좌 데이터를 그대로 쓰되, 실제 주문 제출만 건너뛰고
# 계산 결과를 로그로 남깁니다. 실투자 전환 전 반드시 여러 거래일 동안 true로 돌려
# 로그를 확인하세요 (자세한 내용은 운영 런북 문서 7장 참고).
DRY_RUN=true

# --- 매매 대상 종목 ---
TICKER=TQQQ
# 거래소구분: NA=AMEX, ND=NASDAQ, NY=NYSE. TQQQ는 NASDAQ 상장이므로 기본값 ND.
EXCHANGE_CODE=ND

# --- 무한매수법 전략 파라미터 ---
# 분할수: 20 또는 40만 허용됩니다.
SPLIT_COUNT=40

# 총 원금(USD). 실제 투입하실 금액으로 반드시 직접 채워 넣으세요. (예: 10000)
PRINCIPAL=

# 사이클 재시작 시 원금 계산 방식.
#   true  = 복리 (직전 사이클 종료 시점 잔금을 다음 원금으로 그대로 이어받음)
#   false = 단리 (항상 PRINCIPAL 값으로 고정 재시작)
COMPOUND_ON_RESTART=true

# --- 저장 경로 (보통 기본값 그대로 사용, Docker 볼륨 마운트 경로와 일치해야 함) ---
# DB_PATH=./data/infinite_buying.db
# EVENT_LOG_PATH=./data/event_log.jsonl

# --- 로컬 대시보드 포트 ---
DASHBOARD_PORT=8000
